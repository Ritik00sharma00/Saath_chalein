# Copy to .env.local and fill in real values.
# NOTE: NEXT_PUBLIC_* vars are exposed to the browser, so never put secrets here.

# Backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8081

# API key required by the backend (X-API-KEY header)
NEXT_PUBLIC_API_KEY=saathchalein-api-key

# App display name
NEXT_PUBLIC_APP_NAME=SaathChalein